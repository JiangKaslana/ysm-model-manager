      "instanceLevel": true,
      "preview": "3d",
      "detector": "zipentry",
      "zipEntries": [{ "name": "maid_model.json", "match": "suffix" }, { "name": "chair_model.json", "match": "suffix" }],
      "isDir": true,
      "dirLevelSync": true,
      "nestedModelDir": true,
      "installExts": [".json", ".png", ".js"],
      "actions": ["import", "delete", "openFolder"]
    },
