      "icon": "🎨",
      "group": "minecraft",
      "groupLabel": "Minecraft 原版",
      "groupIcon": "⛏️",
      "extensions": [".zip", ".7z"],
      "configField": "ResourcepackRoot",
      "installDir": "resourcepacks/",
      "scanDir": "resourcepacks",
      "instanceLevel": false,
      "preview": "thumbnail",
      "detector": "zipentry",
      "zipEntries": [{ "name": ".vanilla-assets", "match": "suffix" }],
      "subtypes": [
        {
          "name": "resourcepack", "label": "资源包", "icon": "🎨",
          "userImportable": true, "default": true,
          "extensions": [".zip", ".7z"],
          "detector": "mcmeta",
          "zipEntries": [{ "name": "pack.mcmeta", "match": "exact" }],
          "preview": "thumbnail",
          "installDir": "resourcepacks/", "scanDir": "resourcepacks"
        },
        {
          "name": "shaderpack", "label": "光影包", "icon": "☀️",
          "userImportable": true,
          "extensions": [".zip", ".7z"],
          "detector": "shader",
          "zipEntries": [{ "name": "shaders/", "match": "prefix" }, { "name": "shaders", "match": "exact" }],
          "preview": "thumbnail",
          "installDir": "shaderpacks/", "scanDir": "shaderpacks"
        }
      ],
      "actions": [
        "import",
        "delete",
        "openFolder"
      ]
    },
