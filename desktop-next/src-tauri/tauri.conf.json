{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YSM Model Manager Next",
  "version": "0.2.0",
  "identifier": "io.github.jiangkaslana.ysm-model-manager.next",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YSM Model Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
